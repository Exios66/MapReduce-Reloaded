#!/bin/sh
# Runs the full local check suite before every `git push`.
# CircleCI runs the same checks on pull requests (ADR 0002, ADR 0014, docs/ci.md).
# Bypass in an emergency with: git push --no-verify
#
# `make check` tests the working tree, so the hook only lets a push through
# when the working tree is exactly the commit being pushed: every pushed branch
# must point at HEAD, and there must be no uncommitted or untracked files.
set -e
cd "$(git rev-parse --show-toplevel)"

# git writes one line per ref: <local ref> <local oid> <remote ref> <remote oid>
head=$(git rev-parse HEAD)
pushing=false
while read -r local_ref local_oid remote_ref _; do
    # Deleting a remote branch sends an all-zero oid; there is nothing to test.
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac
    # Only branch updates are checked. Tags (and other refs) name commits that
    # were checked when their branch was pushed.
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac

    if [ "$(git rev-parse "$local_oid^{commit}")" != "$head" ]; then
        echo "pre-push: $local_ref is not checked out; check it out and push again." >&2
        exit 1
    fi
    pushing=true
done
[ "$pushing" = true ] || exit 0

if [ -n "$(git status --porcelain --untracked-files=all)" ]; then
    echo "pre-push: commit or stash your changes first, so 'make check' tests the pushed commit." >&2
    exit 1
fi

# Git run from a desktop app or an IDE often gives hooks a PATH without the
# toolchain a login shell sets up. Add the places scripts/vm-setup.sh and the
# Go installer use, after the PATH given, so a tool found there still wins.
for dir in "$HOME/.local/go/bin" /usr/local/go/bin "$HOME/go/bin" "$PWD/.tools/bin" "$HOME/.local/bin"; do
    case ":$PATH:" in *":$dir:"*) continue ;; esac
    [ -d "$dir" ] && PATH="$PATH:$dir"
done
export PATH

echo "pre-push: running 'make check'..."
make check
