@@ -0,0 +1,70 @@
+package coordinator
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// maxEvents is how many events the status page's tail remembers: a minute
+// of trying, enough numbers to keep the read moving.
+const maxEvents = 128
+
+// Event is one thing the coordinator tells the status page's event tail:
+// when, which level, the message, and the attributes worth showing.
+type Event struct {
+	At    time.Time
+	Level string // "info", "warn" or "error"
+	Msg   string
+	Kv    []EventAttr
+}
+
+// EventAttr is one attribute of an event: its name and value as fmt writes
+// the value. The names come from the log call sites.
+type EventAttr struct {
+	Name  string
+	Value string
+}
+
+// event records what the handlers log to slog also for the status page's
+// tail. It runs under the lock, as its callers (all the report and assign
+// paths) hold it; the level and message name the state change, and the
+// name=value pairs its callers give it carry what the log has.
+func (s *Server) event(at time.Time, level, msg string, kv ...any) {
+	if len(kv)%2 != 0 {
+		kv = kv[:len(kv)-1] // a stray last value: fmt.Fprintf would say it twice
+	}
+	e := Event{At: at, Level: level, Msg: msg}
+	for i := 0; i < len(kv); i += 2 {
+		name, _ := kv[i].(string)
+		e.Kv = append(e.Kv, EventAttr{Name: name, Value: fmt.Sprint(kv[i+1])})
+	}
+	if len(s.events) == maxEvents {
+		copy(s.events, s.events[1:])
+		s.events = s.events[:maxEvents-1]
+	}
+	s.events = append(s.events, e)
+}
+
+// String is the event the way the tail shows it: "16:42:51 msg k=v k=v".
+func (e Event) String() string {
+	var b strings.Builder
+	if !e.At.IsZero() {
+		b.WriteString(e.At.Format("15:04:05"))
+		b.WriteString(" ")
+	}
+	b.WriteString(e.Msg)
+	for _, a := range e.Kv {
+		b.WriteString(" ")
+		b.WriteString(a.Name)
+		b.WriteString("=")
+		// quote only what needs it, so a job id reads uncamouflaged
+		if a.Value == "" || strings.ContainsAny(a.Value, " =\"") {
+			b.WriteString(strconv.Quote(a.Value))
+		} else {
+			b.WriteString(a.Value)
+		}
+	}
+	return b.String()
+}
