diff --git a/go/internal/statusweb/events.go b/go/internal/statusweb/events.go
new file mode 100644
index 0000000..faf74d7
--- /dev/null
+++ b/go/internal/statusweb/events.go
@@ -0,0 +1,41 @@
+package statusweb
+
+import (
+	"github.com/exios66/mapreduce-reloaded/go/internal/coordinator"
+)
+
+// jsonEvents is the shape of /events.json: the coordinator's kept events,
+// oldest first, with Unix-second timestamps. The page's event tail is
+// these events as text; this JSON holds the same data for anyone reading
+// the run without the page.
+type jsonEvents struct {
+	At     float64     `json:"at"`
+	Events []jsonEvent `json:"events"`
+}
+
+// jsonEvent is one kept event: when, which level, the message, and its
+// attributes with names first, since the JSON map would reorder them.
+type jsonEvent struct {
+	At    float64         `json:"at"`
+	Level string          `json:"level"`
+	Msg   string          `json:"msg"`
+	Kv    []jsonEventAttr `json:"kv"`
+}
+
+type jsonEventAttr struct {
+	Name  string `json:"name"`
+	Value string `json:"value"`
+}
+
+// toJSONEvents is st's event tail in the shape of /events.json.
+func toJSONEvents(st coordinator.Status) jsonEvents {
+	out := jsonEvents{At: *unix(st.At), Events: []jsonEvent{}}
+	for _, e := range st.Events {
+		ev := jsonEvent{At: *unix(e.At), Level: e.Level, Msg: e.Msg, Kv: []jsonEventAttr{}}
+		for _, a := range e.Kv {
+			ev.Kv = append(ev.Kv, jsonEventAttr{Name: a.Name, Value: a.Value})
+		}
+		out.Events = append(out.Events, ev)
+	}
+	return out
+}
