{
  "uid": "mapreduce",
  "title": "MapReduce",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "tags": [
    "mapreduce"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Live workers",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mr_workers",
          "legendFormat": "workers"
        }
      ]
    },
    {
      "id": 2,
      "title": "Job progress",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, kind) (mr_job_tasks{state=\"completed\"}) / sum by (job, kind) (mr_job_tasks{state=\"total\"} > 0)",
          "legendFormat": "{{job}} {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Tasks by kind and state",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, state) (mr_job_tasks)",
          "legendFormat": "{{kind}} {{state}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Task attempts finished per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, result) (rate(mr_worker_tasks_total[1m]))",
          "legendFormat": "{{kind}} {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Bytes per second: input, map output, shuffle, output",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(mr_worker_map_input_bytes_total[1m]))",
          "legendFormat": "input"
        },
        {
          "refId": "B",
          "expr": "sum(rate(mr_worker_map_output_bytes_total[1m]))",
          "legendFormat": "map output"
        },
        {
          "refId": "C",
          "expr": "sum(rate(mr_worker_shuffle_fetched_bytes_total[1m]))",
          "legendFormat": "shuffle"
        },
        {
          "refId": "D",
          "expr": "sum(rate(mr_worker_reduce_output_bytes_total[1m]))",
          "legendFormat": "output"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Job duration",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mr_job_duration_seconds",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Backup attempts",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "mr_job_backups",
          "legendFormat": "{{job}} {{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      }
    }
  ]
}
